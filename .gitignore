# =====================================================================
#  📦 InventarioMVP · .gitignore
#  .NET 10 · Windows Forms · MySQL · Visual Studio 2026
#  Regla de oro: lo que se genera, lo personal y los secretos NO se suben.
# =====================================================================


# ---------------------------------------------------------------------
# 🔐 SECRETOS Y CONFIGURACIÓN LOCAL  (¡lo más importante!)
#    La plantilla appsettings.example.json SÍ se sube; el real, nunca.
# ---------------------------------------------------------------------
InventarioMVP/appsettings.json
**/appsettings.*.json
!**/appsettings.example.json
*.env
.env.*
*.pfx
*.p12
*.snk
*.pem
*.key
secrets.json
*.publishsettings


# ---------------------------------------------------------------------
# 🗄️ BASE DE DATOS (herramientas y copias locales)
# ---------------------------------------------------------------------
BaseDatos/limpiar_datos_prueba.sql
BaseDatos/*.local.sql
BaseDatos/*.dump.sql
*.sqlite
*.sqlite3
*.mdf
*.ldf


# ---------------------------------------------------------------------
# 🏗️ COMPILACIÓN  (se regenera con dotnet build)
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM/
ARM64/
publish/
artifacts/
*.pdb
*.dll.config
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json


